# Postgres. Locally both point at docker compose; on Neon use the -pooler URL for
# DATABASE_URL and the direct URL for DATABASE_URL_UNPOOLED (migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/app

# Models as provider:model ids, resolved through the AI SDK provider registry.
# Defaults run locally on Ollama (`brew install --cask ollama-app`, then pull the models).
INTAKE_MODEL=ollama:gemma4:12b
REASONING_MODEL=ollama:qwen3.6:27b
EMBEDDING_MODEL=ollama:bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# Hosted alternatives, e.g. INTAKE_MODEL=anthropic:claude-haiku-5-5,
# EMBEDDING_MODEL=voyage:voyage-4 (both 1024-dimension embeddings).
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# Optional: Langfuse tracing, on only when all three are set. These match the project the
# local stack creates: bun run langfuse:up (bun run langfuse:down stops it)
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_BASE_URL=http://localhost:3001
