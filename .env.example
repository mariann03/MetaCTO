# Postgres. Locally both point at docker compose; on Neon use the -pooler URL for
# DATABASE_URL and the direct URL for DATABASE_URL_UNPOOLED (migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/app

# Models as provider:model ids, resolved through the AI SDK provider registry.
INTAKE_MODEL=anthropic:claude-haiku-5-5
REASONING_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=voyage:voyage-4

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# Optional: Langfuse tracing is enabled only when these are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3001
